# Copy to .env and fill in. .env is gitignored and never committed.

# Required: used for speech recognition, summaries and generated audio.
OPENAI_API_KEY=

# Required for translation: absolute path to a Google Cloud service-account
# JSON key. Leave this commented out to use JSON/google_key.json in the project
# directory, which is gitignored.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google_key.json

# Optional model overrides.
# SUMMARY_MODEL=gpt-4o-mini
# TTS_MODEL=tts-1
# TTS_VOICE=nova

# Speech recognition: "openai" calls the hosted API, "local" runs
# faster-whisper on this machine (pip install -r requirements-local-asr.txt).
# ASR_BACKEND=openai
# LOCAL_ASR_MODEL=base

# Optional limits.
# MAX_VIDEO_SECONDS=10800
# TTS_MAX_CHARS=20000
# MAX_CONCURRENT_JOBS=2

# Set to 1 only for local debugging. Never enable this on a public host: it
# turns tracebacks into a remote Python console.
# FLASK_DEBUG=0
